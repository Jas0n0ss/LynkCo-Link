<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.osnplay.lynk" />
        <package android:name="com.osnplay" />
        <package android:name="com.osnplay.lynk.preview" />
        <package android:name="com.osnplay.preview" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_carplay"
        android:label="OSNPlay"
        android:roundIcon="@drawable/ic_carplay"
        android:theme="@android:style/Theme.NoDisplay">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
